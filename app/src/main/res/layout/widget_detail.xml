<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/detailPreviewFrame"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#111111">

            <ImageView
                android:id="@+id/detailPreviewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/current_walltaker_image"
                android:scaleType="fitCenter"
                android:src="@drawable/test_img" />

            <VideoView
                android:id="@+id/detailPreviewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

        <Button
            android:id="@+id/downloadImageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/download_image" />

        <EditText
            android:id="@+id/detailLinkId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/link_id_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/detailCropCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crop_to_fill" />

        <Button
            android:id="@+id/saveWidgetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_widget_settings" />

        <EditText
            android:id="@+id/detailResponseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/reaction_message_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="48dp" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/responseDisgustButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/reaction_hate_it"
                android:text="@string/reaction_disgust_icon"
                android:textSize="22sp" />

            <Button
                android:id="@+id/responseHornyButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/reaction_ok"
                android:text="@string/reaction_ok_icon"
                android:textSize="22sp" />

            <Button
                android:id="@+id/responseLoveButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/reaction_love_it"
                android:text="@string/reaction_horny_icon"
                android:textSize="22sp" />

            <Button
                android:id="@+id/responseCameButton"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:contentDescription="@string/reaction_came"
                android:text="@string/reaction_came_icon"
                android:textSize="22sp" />

        </LinearLayout>

        <Button
            android:id="@+id/openDirectLinkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/open_direct_link" />

    </LinearLayout>
</ScrollView>
