<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/general_header">

        <EditTextPreference
            app:defaultValue="@string/default_walltaker_url"
            app:key="walltakerBaseUrl"
            app:title="@string/walltaker_url_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:inputType="textPassword"
            app:key="walltakerApiKey"
            app:summary="@string/api_key_setting_summary"
            app:title="@string/api_key_setting_title" />

    </PreferenceCategory>

</PreferenceScreen>
